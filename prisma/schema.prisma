// SWAROOP Phase 2 — Centralized domain model
// Single source of truth for Customer, Seller, and Admin platforms.
// Business REST APIs are intentionally NOT implemented in Phase 2.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

