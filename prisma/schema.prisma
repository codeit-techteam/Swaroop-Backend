// =============================================================================
// IDENTITY & RBAC
// =============================================================================

model User {
  id            String     @id @default(uuid()) @db.Uuid
  email         String?    @unique
  phone         String?    @unique
  passwordHash  String?    @map("password_hash")
  firstName     String?    @map("first_name")
  lastName      String?    @map("last_name")
  displayName   String?    @map("display_name")
  avatarUrl     String?    @map("avatar_url")
  status        UserStatus @default(PENDING)
  emailVerified Boolean    @default(false) @map("email_verified")
  phoneVerified Boolean    @default(false) @map("phone_verified")
  lastLoginAt   DateTime?  @map("last_login_at")
  metadata      Json?
  createdAt     DateTime   @default(now()) @map("created_at")
  updatedAt     DateTime   @updatedAt @map("updated_at")
  deletedAt     DateTime?  @map("deleted_at")

  memberships             OrganizationMember[]
  userRoles               UserRole[]
  customerProfile         CustomerProfile?
  sellerProfile           SellerProfile?
  adminProfile            AdminProfile?
  uploadedDocuments       Document[]               @relation("DocumentUploader")
  notifications           Notification[]           @relation("NotificationRecipient")
  notificationPreferences NotificationPreference[]
  auditLogs               AuditLog[]               @relation("AuditActor")
  assignedCreditApplications CreditApplication[]   @relation("CreditApplicationAssignee")
  assignedCreditProfiles  CustomerCreditProfile[]  @relation("CreditProfileAssignee")
  creditTransactions      CreditTransaction[]      @relation("CreditTransactionActor")
  createdCmsBanners       CmsBanner[]              @relation("CmsBannerCreatedBy")
  assignedProcurements    ProcurementAssignment[]
  procurementActivities   ProcurementActivity[]
  createdOffers           Offer[]                  @relation("OfferCreatedBy")
  createdPurchaseRequests PurchaseRequest[]        @relation("PrCreatedBy")
  verifiedPayments        Payment[]                @relation("PaymentVerifiedBy")
  assignedBulkLogisticsQuotes BulkLogisticsQuoteRequest[] @relation("BulkLogisticsQuoteAssignee")
  authSessions            AuthSession[]
  otpVerifications        OtpVerification[]
  passwordResetTokens     PasswordResetToken[]

  @@index([status])
  @@index([createdAt])
  @@map("users")
}

model Organization {
  id                 String             @id @default(uuid()) @db.Uuid
  code               String?            @unique
  name               String
  legalName          String?            @map("legal_name")
  type               OrganizationType
  status             OrganizationStatus @default(DRAFT)
  businessType       String?            @map("business_type")
  constitutionType   String?            @map("constitution_type")
  industry           String?
  gstin              String?
  pan                String?
  cin                String?
  msmeNumber         String?            @map("msme_number")
  email              String?
  phone              String?
  website            String?
  logoUrl            String?            @map("logo_url")
  verificationStatus VerificationStatus @default(PENDING) @map("verification_status")
  verifiedAt         DateTime?          @map("verified_at")
  metadata           Json?
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")
  deletedAt          DateTime?          @map("deleted_at")

  members             OrganizationMember[]
  addresses           Address[]
  customerProfile     CustomerProfile?
  sellerProfile       SellerProfile?
  warehouses          Warehouse[]
  documents           Document[]           @relation("OrganizationDocuments")
  products            Product[]
  inventory           Inventory[]
  offers              Offer[]
  carts               Cart[]
  purchaseRequests    PurchaseRequest[]    @relation("PrCustomerOrg")
  sellerPurchaseReqs  PurchaseRequest[]    @relation("PrSellerOrg")
  procurements        ProcurementCase[]
  customerOrders      Order[]              @relation("OrderCustomerOrg")
  sellerOrders        Order[]              @relation("OrderSellerOrg")
  customerPOs         PurchaseOrder[]      @relation("PoCustomerOrg")
  sellerPOs           PurchaseOrder[]      @relation("PoSellerOrg")
  payments            Payment[]
  paymentSellerOrgs   Payment[]            @relation("PaymentSellerOrg")
  customerProformas   ProformaInvoice[]    @relation("PiCustomerOrg")
  sellerProformas     ProformaInvoice[]    @relation("PiSellerOrg")
  customerInvoices    FinanceInvoice[]     @relation("InvCustomerOrg")
  sellerInvoices      FinanceInvoice[]     @relation("InvSellerOrg")
  shipmentsAsCustomer Shipment[]           @relation("ShipmentCustomerOrg")
  shipmentsAsSeller   Shipment[]           @relation("ShipmentSellerOrg")
  settlements         Settlement[]
  bankAccounts        BankAccount[]
  notifications       Notification[]
  auditLogs           AuditLog[]
  checkoutQuotesAsCustomer CheckoutQuote[] @relation("CheckoutQuoteCustomerOrg")
  checkoutQuotesAsSeller   CheckoutQuote[] @relation("CheckoutQuoteSellerOrg")

  @@index([type])
  @@index([status])
  @@index([gstin])
  @@index([pan])
  @@index([verificationStatus])
  @@map("organizations")
}

model OrganizationMember {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  userId         String           @map("user_id") @db.Uuid
  title          String?
  isPrimary      Boolean          @default(false) @map("is_primary")
  status         MembershipStatus @default(ACTIVE)
  joinedAt       DateTime?        @map("joined_at")
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
  @@index([status])
  @@map("organization_members")
}

model Role {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique
  name        String
  description String?
  isSystem    Boolean  @default(true) @map("is_system")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  permissions RolePermission[]
  users       UserRole[]

  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique
  name        String
  module      String
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  roles RolePermission[]

  @@index([module])
  @@map("permissions")
}

model RolePermission {
  id           String   @id @default(uuid()) @db.Uuid
  roleId       String   @map("role_id") @db.Uuid
  permissionId String   @map("permission_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  id             String    @id @default(uuid()) @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  roleId         String    @map("role_id") @db.Uuid
  organizationId String?   @map("organization_id") @db.Uuid
  assignedAt     DateTime  @default(now()) @map("assigned_at")
  expiresAt      DateTime? @map("expires_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId, organizationId])
  @@index([userId])
  @@index([roleId])
  @@map("user_roles")
}

// =============================================================================
// PROFILES
// =============================================================================

model CustomerProfile {
  id                String         @id @default(uuid()) @db.Uuid
  userId            String         @unique @map("user_id") @db.Uuid
  organizationId    String         @unique @map("organization_id") @db.Uuid
  status            CustomerStatus @default(DRAFT)
  creditStatus      CreditStatus   @default(NOT_APPLIED) @map("credit_status")
  preferredCurrency CurrencyCode   @default(INR) @map("preferred_currency")
  notes             String?
  metadata          Json?
  createdAt         DateTime       @default(now()) @map("created_at")
  updatedAt         DateTime       @updatedAt @map("updated_at")
  deletedAt         DateTime?      @map("deleted_at")

  user             User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization     Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  preferences      CustomerPreference?
  creditProfile    CustomerCreditProfile?
  creditApplications CreditApplication[]
  creditTransactions CreditTransaction[]
  creditInsurance  CreditInsurance?
  cart             Cart?
  purchaseRequests PurchaseRequest[]
  orders           Order[]
  checkoutQuotes   CheckoutQuote[]
  bulkLogisticsQuotes BulkLogisticsQuoteRequest[]

  @@index([status])
  @@index([creditStatus])
  @@map("customer_profiles")
}

model BulkLogisticsQuoteRequest {
  id                String                    @id @default(uuid()) @db.Uuid
  requestNumber     String                    @unique @map("request_number")
  customerProfileId String                    @map("customer_profile_id") @db.Uuid
  status            BulkLogisticsQuoteStatus  @default(SUBMITTED)
  contactName       String                    @map("contact_name")
  companyName       String                    @map("company_name")
  email             String
  phone             String
  materialName      String                    @map("material_name")
  quantityMt        Decimal                   @map("quantity_mt") @db.Decimal(18, 3)
  pickupLocation    String                    @map("pickup_location")
  deliveryLocation  String                    @map("delivery_location")
  preferredDate     DateTime?                 @map("preferred_date") @db.Date
  message           String?
  adminNotes        String?                   @map("admin_notes")
  assignedAdminId   String?                   @map("assigned_admin_id") @db.Uuid
  reviewedAt        DateTime?                 @map("reviewed_at")
  closedAt          DateTime?                 @map("closed_at")
  metadata          Json?
  createdAt         DateTime                  @default(now()) @map("created_at")
  updatedAt         DateTime                  @updatedAt @map("updated_at")

  customerProfile CustomerProfile @relation(fields: [customerProfileId], references: [id], onDelete: Cascade)
  assignedAdmin   User?           @relation("BulkLogisticsQuoteAssignee", fields: [assignedAdminId], references: [id])

  @@index([customerProfileId, status])
  @@index([status, createdAt])
  @@index([assignedAdminId])
  @@map("bulk_logistics_quote_requests")
}

model CustomerPreference {
  id                     String         @id @default(uuid()) @db.Uuid
  customerProfileId      String         @unique @map("customer_profile_id") @db.Uuid
  preferredGrades        Json?          @map("preferred_grades")
  preferredPaymentMethod PaymentMethod? @map("preferred_payment_method")
  notifyEmail            Boolean        @default(true) @map("notify_email")
  notifySms              Boolean        @default(true) @map("notify_sms")
  notifyPush             Boolean        @default(true) @map("notify_push")
  metadata               Json?
  createdAt              DateTime       @default(now()) @map("created_at")
  updatedAt              DateTime       @updatedAt @map("updated_at")

  customerProfile CustomerProfile @relation(fields: [customerProfileId], references: [id], onDelete: Cascade)

  @@map("customer_preferences")
}

model CustomerCreditProfile {
  id                String              @id @default(uuid()) @db.Uuid
  customerProfileId String              @unique @map("customer_profile_id") @db.Uuid
  accountNumber     String?             @unique @map("account_number")
  status            CreditStatus        @default(PENDING)
  accountStatus     CreditAccountStatus @default(ACTIVE) @map("account_status")
  requestedLimit    Decimal?            @map("requested_limit") @db.Decimal(18, 2)
  approvedLimit     Decimal?            @map("approved_limit") @db.Decimal(18, 2)
  availableLimit    Decimal?            @map("available_limit") @db.Decimal(18, 2)
  utilizedAmount    Decimal             @default(0) @map("utilized_amount") @db.Decimal(18, 2)
  pendingCredit     Decimal             @default(0) @map("pending_credit") @db.Decimal(18, 2)
  outstandingAmount Decimal             @default(0) @map("outstanding_amount") @db.Decimal(18, 2)
  overdueAmount     Decimal             @default(0) @map("overdue_amount") @db.Decimal(18, 2)
  currency          CurrencyCode        @default(INR)
  creditTermDays    Int?                @map("credit_term_days")
  interestRateBps   Int?                @map("interest_rate_bps")
  approvedAt        DateTime?           @map("approved_at")
  effectiveAt       DateTime?           @map("effective_at")
  expiresAt         DateTime?           @map("expires_at")
  reviewAt          DateTime?           @map("review_at")
  assignedAdminId   String?             @map("assigned_admin_id") @db.Uuid
  notes             String?
  metadata          Json?
  createdAt         DateTime            @default(now()) @map("created_at")
  updatedAt         DateTime            @updatedAt @map("updated_at")

  customerProfile CustomerProfile     @relation(fields: [customerProfileId], references: [id], onDelete: Cascade)
  assignedAdmin   User?               @relation("CreditProfileAssignee", fields: [assignedAdminId], references: [id])
  applications    CreditApplication[]
  transactions    CreditTransaction[]
  insurance       CreditInsurance?

  @@index([status])
  @@index([accountStatus])
  @@index([assignedAdminId])
  @@map("customer_credit_profiles")
}

model CreditApplication {
  id                  String                   @id @default(uuid()) @db.Uuid
  applicationNumber   String                   @unique @map("application_number")
  customerProfileId   String                   @map("customer_profile_id") @db.Uuid
