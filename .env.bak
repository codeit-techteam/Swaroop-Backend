# =============================================================================
# SWAROOP Centralized Backend — Environment Template
# =============================================================================
# Copy this file to `.env` and replace placeholder values.
# NEVER commit real credentials or a populated `.env` file.
# =============================================================================

# Application
APP_NAME=swaroop-backend
NODE_ENV=development
PORT=3000
API_PREFIX=api
API_VERSION=1

# PostgreSQL (DigitalOcean Managed PostgreSQL OR Azure Database for PostgreSQL)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public&sslmode=require
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/swaroop?schema=public

# Security (placeholders only — replace before any non-local use)
# Authentication APIs are NOT implemented in Phase 1; these prepare future modules.
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=7d

# CORS — comma-separated origins for Customer/Seller/Admin web & mobile clients
# Example: http://localhost:3000,http://localhost:5173,https://app.example.com
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:4173

# Cloudflare R2 (S3-compatible object storage)
CLOUDFLARE_R2_ACCOUNT_ID=your-cloudflare-account-id
CLOUDFLARE_R2_ACCESS_KEY_ID=your-r2-access-key-id
CLOUDFLARE_R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
CLOUDFLARE_R2_BUCKET_NAME=swaroop-assets
CLOUDFLARE_R2_PUBLIC_URL=https://your-public-r2-domain.example.com

# Logging
LOG_LEVEL=info

# Optional rate-limit foundation (requests per TTL window)
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=100
