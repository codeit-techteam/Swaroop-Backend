# =============================================================================
# PolyStoreX Backend — environment TEMPLATE (safe to commit)
# =============================================================================
# Copy to `.env` and fill real values locally / in the host secret store:
#   cp .env.example .env
#
# NEVER commit a populated `.env` file.
# NEVER put real passwords, API tokens, private keys, or auth keys in this file.
# Use placeholders only. Real secrets live in DigitalOcean / local `.env`.
# =============================================================================

# Application
APP_NAME=swaroop-backend
NODE_ENV=development
PORT=4000
API_PREFIX=api
API_VERSION=1

# PostgreSQL — replace USER/PASSWORD/HOST with your managed DB credentials
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public&sslmode=require
DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:5433/swaroop?schema=public

# JWT — generate long random secrets for every non-local environment
JWT_ACCESS_SECRET=change-me-access-secret-min-32-characters-long
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-characters-long
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=15m

# Admin portal bootstrap (password must be set in real `.env` / host secrets)
PLATFORM_ADMIN_EMAIL=admin@example.com
PLATFORM_ADMIN_PASSWORD=

# OTP / password reset
OTP_LENGTH=6
OTP_EXPIRES_IN_SECONDS=600
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_SENDS_PER_HOUR=5
OTP_IP_MAX_REQUESTS=20
OTP_IP_WINDOW_SECONDS=3600
PASSWORD_RESET_EXPIRES_IN_SECONDS=1800
BCRYPT_SALT_ROUNDS=12

# OTP provider: msg91 (production SMS) | local (dev stub, no SMS)
OTP_PROVIDER=local
OTP_ENVIRONMENT=development

# MSG91 — server-side only. Leave blank here; set real values in host secrets.
MSG91_AUTH_KEY=
MSG91_OTP_TEMPLATE_ID=
MSG91_SENDER_ID=
MSG91_HEADER=
MSG91_DLT_ENTITY_ID=
MSG91_DLT_TEMPLATE_ID=
MSG91_TIMEOUT_MS=15000

# OTP safety — never enable fixed/demo OTP in production
AUTH_DEV_EXPOSE_OTP=false
AUTH_DEV_FIXED_OTP=false
AUTH_STRICT_OTP=true

# CORS — comma-separated browser origins (localhost OK for local only)
CORS_ALLOW_PLATFORM_HOSTS=false
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:3003,http://localhost:3004,http://localhost:4000,http://localhost:5173,http://localhost:8081

# Cloudflare R2 (S3-compatible) — never commit real access keys
STORAGE_PROVIDER=r2
MAX_DOCUMENT_SIZE_MB=20
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=your-bucket-name
R2_PUBLIC_BASE_URL=
R2_REGION=auto
R2_SIGNED_URL_EXPIRY=900
CLOUDFLARE_R2_ACCOUNT_ID=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET_NAME=your-bucket-name
CLOUDFLARE_R2_PUBLIC_URL=

# Logging / workers
LOG_LEVEL=info
PR_SOURCING_SWEEP_INTERVAL_MS=30000
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=300
THROTTLE_MARKETPLACE_LIMIT=600

# Google Maps (server) — IP-restricted Places/Geocoding key only
GOOGLE_MAPS_SERVER_API_KEY=
GOOGLE_MAPS_TIMEOUT_MS=6000
GOOGLE_MAPS_REGION_CODE=IN

# Import trading / grade master
IMPORT_FEATURE_ENABLED=true
IMPORT_EXPIRY_SWEEP_INTERVAL_MS=60000
IMPORT_MASTER_DATA_AUTO_SEED=true
GRADE_MASTER_BUNDLED_IMPORT=true

# KYC — Surepass (token in host secrets only)
SUREPASS_API_BASE_URL=
SUREPASS_API_TOKEN=
SUREPASS_ENVIRONMENT=
SUREPASS_PAN_PATH=
SUREPASS_GST_PATH=
PAN_VERIFICATION_PROVIDER=http
PAN_VERIFICATION_API_URL=
PAN_VERIFICATION_API_KEY=
PAN_VERIFICATION_CLIENT_ID=
GST_VERIFICATION_PROVIDER=http
GST_VERIFICATION_API_URL=
GST_VERIFICATION_API_KEY=
GST_VERIFICATION_CLIENT_ID=
KYC_VERIFICATION_TIMEOUT_MS=10000
KYC_VERIFY_ATTEMPTS_PER_HOUR=10
KYC_UPLOADS_PER_HOUR=30
KYC_ENFORCE_FOR_TRADING=true

# Commerce pricing (₹/MT)
COMMERCE_FREIGHT_PER_MT=1250
COMMERCE_GST_BPS=1800
COMMERCE_ADVANCE_DISCOUNT_BPS=500
COMMERCE_PLATFORM_FEE=0
COMMERCE_INSURANCE_AMOUNT=0
COMMERCE_QUOTE_TTL_MS=600000
COMMERCE_QTY_INCREMENT=1
COMMERCE_MIN_MATERIAL_PRICE_PER_MT=
COMMERCE_MAX_MATERIAL_PRICE_PER_MT=

# Public legal / support links (non-secret)
PUBLIC_WEBSITE_URL=https://polystorex.com
PUBLIC_TERMS_URL=https://polystorex.com/terms
PUBLIC_PRIVACY_URL=https://polystorex.com/privacy
PUBLIC_SUPPORT_URL=https://polystorex.com/contact
PUBLIC_SUPPORT_EMAIL=connect@polystorex.com
PUBLIC_SUPPORT_PHONE=
PUBLIC_SUPPORT_WHATSAPP=

# Firebase Cloud Messaging — mount credentials via host secrets, never commit JSON
FCM_ENABLED=false
FIREBASE_PROJECT_ID=your-firebase-project-id
GOOGLE_APPLICATION_CREDENTIALS=
FIREBASE_SERVICE_ACCOUNT_JSON=
FCM_DEVICE_REGISTER_LIMIT=30
