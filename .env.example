# =============================================================================
# SWAROOP Centralized Backend — Environment Template
# =============================================================================
# Copy this file to `.env` and replace placeholder values.
# NEVER commit real credentials or a populated `.env` file.
# =============================================================================

# Application
APP_NAME=swaroop-backend
NODE_ENV=development
# Use 4000 locally so Next.js customer/seller/admin apps can keep 3000–3002.
PORT=4000
API_PREFIX=api
API_VERSION=1

# PostgreSQL (DigitalOcean Managed PostgreSQL OR Azure Database for PostgreSQL)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public&sslmode=require
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/swaroop?schema=public

# JWT (Phase 3) — use strong unique secrets in non-local environments
JWT_ACCESS_SECRET=change-me-access-secret-min-32-characters-long
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-characters-long
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
# Legacy fallback (optional if ACCESS/REFRESH secrets are set)
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=15m

# Admin portal Super Admin — upserted on every boot; password re-synced if changed
PLATFORM_ADMIN_EMAIL=admin@veylorn
PLATFORM_ADMIN_PASSWORD=

# OTP / password reset
OTP_LENGTH=6
OTP_EXPIRES_IN_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=30
PASSWORD_RESET_EXPIRES_IN_SECONDS=1800
BCRYPT_SALT_ROUNDS=12

# OTP provider — use msg91 for production SMS (official Send/Verify/Resend OTP APIs).
# local = generate+hash OTP in-process (development only; SMS is a no-op stub).
OTP_PROVIDER=local
OTP_ENVIRONMENT=development

# MSG91 (server-side only — NEVER expose to mobile/web clients or EXPO_PUBLIC_*/NEXT_PUBLIC_*).
# Required when OTP_PROVIDER=msg91. Values come from the MSG91 dashboard + Airtel DLT.
# Approved template example (confirm in dashboard): MSG91_OTP_TEMPLATE_ID=6ae081288c342f46e203bb12
# Airtel DLT header example: MSG91_HEADER=VELPLY / MSG91_DLT_ENTITY_ID=<header DLT id>
MSG91_AUTH_KEY=
MSG91_OTP_TEMPLATE_ID=
MSG91_SENDER_ID=
MSG91_HEADER=VELPLY
MSG91_DLT_ENTITY_ID=
MSG91_DLT_TEMPLATE_ID=
MSG91_TIMEOUT_MS=15000

# AUTH_DEV_EXPOSE_OTP must stay false in production (never echo OTPs in API responses).
AUTH_DEV_EXPOSE_OTP=true
# Legacy/informational. Fixed demo OTP is disabled by AUTH_STRICT_OTP or active MSG91.
AUTH_DEV_FIXED_OTP=true
# Set AUTH_STRICT_OTP=true for production SMS lock (disables fixed demo OTP 123456).
# Also auto-disabled when OTP_PROVIDER=msg91 and MSG91_AUTH_KEY is set.
AUTH_STRICT_OTP=false

# Seller settlement policy (used when drafting settlements after payment clearance)
# SETTLEMENT_CYCLE_DAYS=7
# SETTLEMENT_PLATFORM_FEE=0
# SETTLEMENT_TDS_RATE=0

# CORS — comma-separated origins for Customer/Seller/Admin web & mobile clients
# Production also allows *.ondigitalocean.app and *.vercel.app automatically (see src/main.ts).
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:3003,http://localhost:4000,http://localhost:5173,http://localhost:3004,http://localhost:8081,https://swaroop-backend-xzwkz.ondigitalocean.app,https://swaroop-customer-webapp.vercel.app,https://swaroop-seller-webapp.vercel.app,https://swaroop-admin-pi.vercel.app,https://swaroop-website.vercel.app

# Client origins used to attribute credit applications (source = WEBSITE,
# CUSTOMER_WEB, SELLER_WEB, ADMIN) from the request Origin header. Optional:
# defaults cover the Vercel production + preview URLs (and localhost outside
# production). Set these when a custom domain goes live. `*` matches one label.
# WEBSITE_ORIGINS=https://swaroop-website.vercel.app,https://swaroop-website-*.vercel.app
# CUSTOMER_WEB_ORIGINS=https://swaroop-customer-webapp.vercel.app
# SELLER_WEB_ORIGINS=https://swaroop-seller-webapp.vercel.app
# ADMIN_WEB_ORIGINS=https://swaroop-admin-pi.vercel.app

# Object storage — Cloudflare R2 (S3-compatible)
# Bucket used by PetroTrade: veylron
STORAGE_PROVIDER=r2
MAX_DOCUMENT_SIZE_MB=20
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=veylron
# Required for production CMS banners — stable public CDN base so APP/WEBAPP
# images do not expire (signed GET URLs last ~1h). Example:
# https://pub-xxxxx.r2.dev  or  https://cdn.yourdomain.com
R2_PUBLIC_BASE_URL=
R2_REGION=auto
R2_SIGNED_URL_EXPIRY=900
# Legacy aliases still supported:
CLOUDFLARE_R2_ACCOUNT_ID=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET_NAME=veylron
CLOUDFLARE_R2_PUBLIC_URL=

# Logging
LOG_LEVEL=info

# Purchase request seller-finding SLA (15-minute response window)
# Background sweep interval for auto-expiry / approaching-deadline warnings
PR_SOURCING_SWEEP_INTERVAL_MS=30000

# Optional global rate-limit foundation (requests per TTL window)
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=100

# Google Maps Platform — server-side key used by /api/v1/locations/* (address
# autocomplete, place details, reverse geocoding) for ALL Customer/Seller web +
# mobile clients. Restrict it by server IP and to: Places API (New), Geocoding API.
# Leave empty to disable Google lookups (clients fall back to manual entry / GPS).
# NEVER commit a real key.
GOOGLE_MAPS_SERVER_API_KEY=
GOOGLE_MAPS_TIMEOUT_MS=6000
GOOGLE_MAPS_REGION_CODE=IN

# Import trading (international BUY RFQs / SELL offers). When false every
# user-facing /api/v1/import/* route returns IMPORT_FEATURE_DISABLED; Admin
# master data stays manageable. Expiry sweep runs on this interval (>= 5000).
IMPORT_FEATURE_ENABLED=true
IMPORT_EXPIRY_SWEEP_INTERVAL_MS=60000
# Insert missing Import reference data (currencies, ports, Incoterms, payment
# terms) from prisma/seed-data/import-master-data.json on startup. Insert-only.
IMPORT_MASTER_DATA_AUTO_SEED=true

# Grade Master: import prisma/seed-data/source-one/*.csv once per file version
# (sha256) on startup. Only Source.One columns are synced; Admin status and
# visibility changes are never overwritten. Manual: npm run import:grades
GRADE_MASTER_BUNDLED_IMPORT=true

# KYC — Surepass PAN / GSTIN verification (server-side only, used by Customer
# App/Web and Seller App/Web through the backend). When both the base URL and
# token are set, Surepass is used for every PAN / GST check and the generic
# PAN_/GST_VERIFICATION_* adapter below is ignored.
#   Production base URL: https://kyc-api.surepass.app  (SUREPASS_ENVIRONMENT=production)
#   Sandbox base URL:    https://sandbox.surepass.app  (SUREPASS_ENVIRONMENT=sandbox)
# Sandbox and production use different tokens; startup fails if the environment
# and host disagree. Endpoint paths default to the documented PAN Verify
# (/api/v1/pan/pan-verify: PAN + name + date of birth / incorporation) and
# Corporate GSTIN (/api/v1/corporate/gstin) APIs, which must be subscribed in
# the Surepass console. Set SUREPASS_PAN_PATH to /api/v1/pan/pan (PAN Lite) or
# /api/v1/pan/pan-adv (PAN Advanced) to verify by PAN number only.
# The token goes ONLY into the deployment environment (DigitalOcean App Platform
# encrypted env var) — NEVER commit it.
SUREPASS_API_BASE_URL=
SUREPASS_API_TOKEN=
SUREPASS_ENVIRONMENT=
SUREPASS_PAN_PATH=
SUREPASS_GST_PATH=

# Generic PAN / GSTIN verification providers (server-side only).
# The backend POSTs {"pan": "..."} / {"gstin": "..."} as JSON with headers
# x-api-key: <API_KEY> and x-client-id: <CLIENT_ID>. Responses using GSTN field
# names (lgnm, tradeNam, sts, rgdt, ctb, pradr) or common camel/snake_case are
# normalized. Leave the URL empty to route every verification to manual
# compliance review instead. NEVER commit real keys.
PAN_VERIFICATION_PROVIDER=http
PAN_VERIFICATION_API_URL=
PAN_VERIFICATION_API_KEY=
PAN_VERIFICATION_CLIENT_ID=
GST_VERIFICATION_PROVIDER=http
GST_VERIFICATION_API_URL=
GST_VERIFICATION_API_KEY=
GST_VERIFICATION_CLIENT_ID=
KYC_VERIFICATION_TIMEOUT_MS=10000
# Per-user limits (rolling hour)
KYC_VERIFY_ATTEMPTS_PER_HOUR=10
KYC_UPLOADS_PER_HOUR=30
# When true, checkout / purchase-request APIs reject customers whose KYC is
# not approved. Turn on once existing customers have completed KYC.
KYC_ENFORCE_FOR_TRADING=false

# Public legal / support links for login screens (GET /api/v1/public/legal-links).
# When PUBLIC_WEBSITE_URL is set (or WEBSITE_ORIGINS has a concrete origin),
# /terms, /privacy and /contact are derived automatically. Overrides win when set.
# Leave PUBLIC_SUPPORT_EMAIL empty unless an approved mailbox is published —
# clients must not invent contact addresses.
# Use the deployed marketing site. petrotrade.in is still a GoDaddy park/lander;
# point PUBLIC_WEBSITE_URL at petrotrade.in only after DNS is attached to Vercel.
# PUBLIC_WEBSITE_URL=https://swaroop-website-mocha.vercel.app
# PUBLIC_TERMS_URL=https://swaroop-website-mocha.vercel.app/terms
# PUBLIC_PRIVACY_URL=https://swaroop-website-mocha.vercel.app/privacy
# PUBLIC_SUPPORT_URL=https://swaroop-website-mocha.vercel.app/contact
# PUBLIC_SUPPORT_EMAIL=
