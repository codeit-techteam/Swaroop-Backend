# =============================================================================
# SWAROOP Centralized Backend — Environment Template
# =============================================================================
# Copy this file to `.env` and replace placeholder values.
# NEVER commit real credentials or a populated `.env` file.
# =============================================================================

# Application
APP_NAME=swaroop-backend
NODE_ENV=development
# Use 4000 locally so Next.js customer/seller/admin apps can keep 3000–3002.
PORT=4000
API_PREFIX=api
API_VERSION=1

# PostgreSQL (DigitalOcean Managed PostgreSQL OR Azure Database for PostgreSQL)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public&sslmode=require
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/swaroop?schema=public

# JWT (Phase 3) — use strong unique secrets in non-local environments
JWT_ACCESS_SECRET=change-me-access-secret-min-32-characters-long
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-characters-long
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
# Legacy fallback (optional if ACCESS/REFRESH secrets are set)
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=15m

# OTP / password reset
OTP_LENGTH=6
OTP_EXPIRES_IN_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
PASSWORD_RESET_EXPIRES_IN_SECONDS=1800
BCRYPT_SALT_ROUNDS=12
# Development only — NEVER enable in production
AUTH_DEV_EXPOSE_OTP=true

# CORS — comma-separated origins for Customer/Seller/Admin web & mobile clients
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:4000,http://localhost:5173,http://localhost:8081

# Object storage — default none (app boots without R2; uploads/downloads return 503)
STORAGE_PROVIDER=none
MAX_DOCUMENT_SIZE_MB=10
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_BASE_URL=
R2_REGION=auto
R2_SIGNED_URL_EXPIRY=900
# Legacy aliases still supported:
CLOUDFLARE_R2_ACCOUNT_ID=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET_NAME=
CLOUDFLARE_R2_PUBLIC_URL=

# Logging
LOG_LEVEL=info

# Optional global rate-limit foundation (requests per TTL window)
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=100
